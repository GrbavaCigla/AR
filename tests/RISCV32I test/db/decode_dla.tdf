--synthesis_resources = lut 8 
SUBDESIGN decode_dla
( 
	data[2..0]	:	input;
	enable	:	input;
	eq[7..0]	:	output;
) 
VARIABLE 
	data_wire[2..0]	: WIRE;
	enable_wire	: WIRE;
	eq_node[7..0]	: WIRE;
	eq_wire[7..0]	: WIRE;
	w_anode432w[3..0]	: WIRE;
	w_anode449w[3..0]	: WIRE;
	w_anode459w[3..0]	: WIRE;
	w_anode469w[3..0]	: WIRE;
	w_anode479w[3..0]	: WIRE;
	w_anode489w[3..0]	: WIRE;
	w_anode499w[3..0]	: WIRE;
	w_anode509w[3..0]	: WIRE;

BEGIN 
	data_wire[] = data[];
	enable_wire = enable;
	eq[] = eq_node[];
	eq_node[7..0] = eq_wire[7..0];
	eq_wire[] = ( w_anode509w[3..3], w_anode499w[3..3], w_anode489w[3..3], w_anode479w[3..3], w_anode469w[3..3], w_anode459w[3..3], w_anode449w[3..3], w_anode432w[3..3]);
	w_anode432w[] = ( (w_anode432w[2..2] & (! data_wire[2..2])), (w_anode432w[1..1] & (! data_wire[1..1])), (w_anode432w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode449w[] = ( (w_anode449w[2..2] & (! data_wire[2..2])), (w_anode449w[1..1] & (! data_wire[1..1])), (w_anode449w[0..0] & data_wire[0..0]), enable_wire);
	w_anode459w[] = ( (w_anode459w[2..2] & (! data_wire[2..2])), (w_anode459w[1..1] & data_wire[1..1]), (w_anode459w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode469w[] = ( (w_anode469w[2..2] & (! data_wire[2..2])), (w_anode469w[1..1] & data_wire[1..1]), (w_anode469w[0..0] & data_wire[0..0]), enable_wire);
	w_anode479w[] = ( (w_anode479w[2..2] & data_wire[2..2]), (w_anode479w[1..1] & (! data_wire[1..1])), (w_anode479w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode489w[] = ( (w_anode489w[2..2] & data_wire[2..2]), (w_anode489w[1..1] & (! data_wire[1..1])), (w_anode489w[0..0] & data_wire[0..0]), enable_wire);
	w_anode499w[] = ( (w_anode499w[2..2] & data_wire[2..2]), (w_anode499w[1..1] & data_wire[1..1]), (w_anode499w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode509w[] = ( (w_anode509w[2..2] & data_wire[2..2]), (w_anode509w[1..1] & data_wire[1..1]), (w_anode509w[0..0] & data_wire[0..0]), enable_wire);
