WIDTH=32;
DEPTH=1024;
ADDRESS_RADIX=HEX;
DATA_RADIX=HEX;

CONTENT BEGIN
    % x10 = 5, x11 = 5 %
    0000 : 00500513;
    0001 : 00500593;

    % BNE must NOT branch: x10 == x11 %
    0002 : 00B51863;

    % Continue execution %
    0003 : 00100513;   % x10 = 1 %
    0004 : 00200593;   % x11 = 2 %

    % BNE must branch to GOOD at PC = 0x20 %
    0005 : 00B51663;

    % BAD: infinite loop at PC = 0x18 %
    0006 : 0000006F;

    % Padding / NOP %
    0007 : 00000013;

    % GOOD: PC must remain exactly 0x20 forever %
    0008 : 0000006F;

    [0009..03FF] : 00000013;
END;
