(text "JALR_TARGET = JALR_SUM[31..1],0" (rect 664 952 874 966)(font "Arial" (font_size 8)))
(text "Data sema predstavlja semu celokupnog riscv32i procesora sa svim periferijama povezanim u finalnu izvrsimu semu projekta LIDAR ld14p za projekat iz Arhitekture Racunara na Elektrotehnickom fakultetu u Beogradu" (rect 680 72 1901 86)(font "Arial" (font_size 8)))
(text "PC logika" (rect 728 640 778 654)(font "Arial" (font_size 8)))
(text "Konstante" (rect 504 320 561 334)(font "Arial" (font_size 8)))
(text "sistemski restart aktivan u nuli kako bi bio kompatibilan sa svim ostalim -> RESET je povezan na dugme koje je na FPGA plocici aktivno u nuli" (rect 360 120 1144 134)(font "Arial" (font_size 8)))
(text "BRANCH Logika za NEXT_PC[31..0]" (rect 648 704 848 718)(font "Arial" (font_size 8)))
(text "Fetch Blok: ->>>>>>>" (rect 624 640 744 654)(font "Arial" (font_size 8)))
(text "Nasa kontrolna rec koju pravimo na osnovu najnizih 7 bita intrukcije, detaljnjije o njima u md fileu" (rect 1576 728 2112 742)(font "Arial" (font_size 8)))
(text "Dekodovanje instrukcije na osnovu adrese i Izvrsavanje instrukcije" (rect 2168 520 2544 534)(font "Arial" (font_size 8)))
(text "Izgled fetchovanja : => na osnovu PC vrednosti se odlazi u InstructionMemory gde se nalazi ROM i iz njega se dobija instrukcija" (rect 1144 520 1861 534)(font "Arial" (font_size 8)))
(text "Nas ROM" (rect 1688 552 1741 566)(font "Arial" (font_size 8)))
(text "Na osnovu instrukcije i immSrc biramo koji je tip instrukcija (J/U/B/S/I)" (rect 2168 552 2552 566)(font "Arial" (font_size 8)))
(text "Registarski file" (rect 2096 984 2178 998)(font "Arial" (font_size 8)))
(text "Execute faza" (rect 2728 952 2803 966)(font "Arial" (font_size 8)))
(text "Upis dozvoljen samo ako magistrala nije zauzeta" (rect 1880 1168 2153 1182)(font "Arial" (font_size 8)))
