(text "CLK je postavljen na klik dugmeta da se testira korak po korak rad VGA kontrolera" (rect 64 24 526 38)(font "Arial" (font_size 8)))
(text "test proverava da li upis funkcionise kako treba" (rect 872 232 1139 246)(font "Arial" (font_size 8)))
(text "ocekivano ponasnje: " (rect 872 264 992 278)(font "Arial" (font_size 8)))
(text "pre prvog klika svi LED su pogaseni" (rect 872 280 1073 294)(font "Arial" (font_size 8)))
(text "(posle prvog klika zapocinje se promena jednog piksela)" (rect 872 296 1188 310)(font "Arial" (font_size 8)))
(text "nakon tri (ili vise klikova) poslednji LED treba da se upali" (rect 872 312 1185 326)(font "Arial" (font_size 8)))
(text "nakon toga pretposlednji i jos jedan LED treba da budu upaljeni, dok ostali treba da budu ugaseni" (rect 872 344 1415 358)(font "Arial" (font_size 8)))
(text "(pretposlednji LED oznacava bas taj piksel koj je promenjen, dok su ostali pre njih cela rec u koju su spakovani pikseli pa jedan od njih takodje treba da bude on)" (rect 872 360 1772 374)(font "Arial" (font_size 8)))
(text "(ovo oznacava da je pixel changed, ako posle dosta klikova nema promene, RAM ili VGA kontroler ne rade lepo)" (rect 872 328 1505 342)(font "Arial" (font_size 8)))
(text "SET_PIXEL aktivno dok ga PIXEL CHANGED ne ugasi" (rect 408 552 704 566)(font "Arial" (font_size 8)))
