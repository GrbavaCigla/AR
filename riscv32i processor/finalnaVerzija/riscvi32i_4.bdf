(text "JALR_TARGET = JALR_SUM[31..1],0" (rect 664 944 874 958)(font "Arial" (font_size 8)))
(text "Data sema predstavlja semu celokupnog riscv32i procesora sa svim periferijama povezanim u finalnu izvrsimu semu projekta LIDAR ld14p za projekat iz Arhitekture Racunara na Elektrotehnickom fakultetu u Beogradu" (rect 680 64 1901 78)(font "Arial" (font_size 8)))
(text "PC logika" (rect 728 632 778 646)(font "Arial" (font_size 8)))
(text "Konstante" (rect 504 312 561 326)(font "Arial" (font_size 8)))
(text "sistemski restart aktivan u nuli kako bi bio kompatibilan sa svim ostalim -> RESET je povezan na dugme koje je na FPGA plocici aktivno u nuli" (rect 360 112 1144 126)(font "Arial" (font_size 8)))
(text "BRANCH Logika za NEXT_PC[31..0]" (rect 648 696 848 710)(font "Arial" (font_size 8)))
(text "Fetch Blok: ->>>>>>>" (rect 624 632 744 646)(font "Arial" (font_size 8)))
(text "Nasa kontrolna rec koju pravimo na osnovu najnizih 7 bita intrukcije, detaljnjije o njima u md fileu" (rect 1576 720 2112 734)(font "Arial" (font_size 8)))
(text "Dekodovanje instrukcije na osnovu adrese i Izvrsavanje instrukcije" (rect 2168 512 2544 526)(font "Arial" (font_size 8)))
(text "Izgled fetchovanja : => na osnovu PC vrednosti se odlazi u InstructionMemory gde se nalazi ROM i iz njega se dobija instrukcija" (rect 1144 512 1861 526)(font "Arial" (font_size 8)))
(text "Nas ROM" (rect 1688 544 1741 558)(font "Arial" (font_size 8)))
(text "Na osnovu instrukcije i immSrc biramo koji je tip instrukcija (J/U/B/S/I)" (rect 2168 544 2552 558)(font "Arial" (font_size 8)))
(text "Registarski file" (rect 2096 976 2178 990)(font "Arial" (font_size 8)))
(text "Execute faza" (rect 2728 944 2803 958)(font "Arial" (font_size 8)))
(text "Upis dozvoljen samo ako magistrala nije zauzeta" (rect 1880 1160 2153 1174)(font "Arial" (font_size 8)))
(text "ADRESA ZA BUS" (rect 3008 1032 3108 1046)(font "Arial" (font_size 8)))
(text "Ulazi" (rect 104 96 131 110)(font "Arial" (font_size 8)))
