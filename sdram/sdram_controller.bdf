(text "2 bita BANK\n13 bita  ROW\n10 bita  COLUMN" (rect 56 608 151 650)(font "Arial" (font_size 8)))
(text "POWER-UP DELAY\nBroji 10000 taktova = 200 us na 50 MHz.\nINIT_DONE se aktivira kada je zavrseno pocetno cekanje." (rect 424 1536 747 1578)(font "Arial" (font_size 8)))
(text "Power-up counter" (rect 272 1392 375 1406)(font "Arial" (font_size 8)))
(text "STATE_PALL\nPokrece PRECHARGE ALL nakon power-up cekanja." (rect 392 1680 690 1708)(font "Arial" (font_size 8)))
(text "STATE_INIT\nPrelazak iz power-up faze u SDRAM inicijalizaciju." (rect 392 1840 676 1868)(font "Arial" (font_size 8)))
(text "INIT REFRESH SEQUENCE\nPosle PRECHARGE ALL izvrsava najmanje 8 AUTO REFRESH ciklusa.\nIzmedju dva refresh-a ceka tRC." (rect 768 104 1160 146)(font "Arial" (font_size 8)))
(text "Cekanje tRP nakon PRECHARGE ALL" (rect 1208 248 1416 262)(font "Arial" (font_size 8)))
(text "AUTO REFRESH komanda tokom inicijalizacije" (rect 1208 384 1462 398)(font "Arial" (font_size 8)))
(text "Broji 8 inicijalizacionih AUTO REFRESH ciklusa" (rect 1240 592 1499 606)(font "Arial" (font_size 8)))
(text "Cekanje tRC nakon AUTO REFRESH komande" (rect 1232 744 1488 758)(font "Arial" (font_size 8)))
(text "tRC timer\n3 takta na 50 MHz = 60 ns" (rect 1264 952 1411 980)(font "Arial" (font_size 8)))
(text "Nastavlja refresh petlju dok nije izvrseno svih 8 ciklusa" (rect 1160 1096 1470 1110)(font "Arial" (font_size 8)))
(text "MODE REGISTER SET / INIT FINISH\nProgramira SDRAM mode register nakon zavrsenih refresh ciklusa.\nZatim ceka tMRD pre normalnog rada." (rect 768 1152 1147 1194)(font "Arial" (font_size 8)))
(text "LOAD MODE REGISTER komanda" (rect 1304 1288 1491 1302)(font "Arial" (font_size 8)))
(text "tMRD wait - clock 1" (rect 1320 1440 1429 1454)(font "Arial" (font_size 8)))
(text "tMRD wait - clock 2" (rect 1312 1576 1421 1590)(font "Arial" (font_size 8)))
(text "Postavlja SDRAM_INIT_DONE nakon kompletne inicijalizacije" (rect 1296 1720 1631 1734)(font "Arial" (font_size 8)))
(text "SDRAM READY\nKontroler je spreman za novi pristup kada je inicijalizacija zavrsena,\nnema aktivnog refresh-a i nema aktivnog READ/WRITE pristupa." (rect 1232 1856 1614 1898)(font "Arial" (font_size 8)))
(text "PERIODIC REFRESH\nNakon inicijalizacije broji vreme do sledeceg refresh-a.\nNa svakih ~7.8 us pokrece PRECHARGE ALL i AUTO REFRESH,\nuz postovanje tRP i tRC vremena." (rect 1680 104 2039 160)(font "Arial" (font_size 8)))
(text "Refresh interval counter\nBroji 390 taktova = ~7.8 us na 50 MHz." (rect 2296 296 2514 324)(font "Arial" (font_size 8)))
(text "Detekcija trenutka za periodicni refresh" (rect 2400 152 2621 166)(font "Arial" (font_size 8)))
(text "STATE_REFRESH_PALL\nPokrece PRECHARGE ALL pre AUTO REFRESH komande." (rect 2128 456 2453 484)(font "Arial" (font_size 8)))
(text "Cekanje tRP nakon PRECHARGE ALL" (rect 2104 600 2312 614)(font "Arial" (font_size 8)))
(text "AUTO REFRESH komanda" (rect 2064 752 2210 766)(font "Arial" (font_size 8)))
(text "REFRESH_ACTIVE\nOznacava da je periodicni refresh u toku.\nBlokira normalni READ/WRITE pristup." (rect 2392 736 2626 778)(font "Arial" (font_size 8)))
(text "tRC timer\n3 takta na 50 MHz = 60 ns" (rect 2232 984 2379 1012)(font "Arial" (font_size 8)))
(text "Kraj tRC cekanja nakon AUTO REFRESH komande" (rect 2384 912 2664 926)(font "Arial" (font_size 8)))
(text "STATE_REFRESH_WAIT_RC\nCekanje potrebnog tRC vremena pre povratka u normalan rad." (rect 2096 1136 2446 1164)(font "Arial" (font_size 8)))
(text "ACCESS START / ACTIVE\nPrihvata READ ili WRITE zahtev kada je SDRAM spreman,\nizdaje ACTIVE komandu i zatim ceka tRCD pre READ/WRITE komande." (rect 1680 1264 2072 1306)(font "Arial" (font_size 8)))
(text "Detekcija READ/WRITE zahteva" (rect 1776 1392 1953 1406)(font "Arial" (font_size 8)))
(text "STATE_ACTIVE\nIzdaje ACTIVEkomandu i otvara izabrani red/banku." (rect 2176 1352 2465 1380)(font "Arial" (font_size 8)))
(text "STATE_WAIT_RCD\nCekanje tRCD nakon ACTIVE komande pre READ/WRITE pristupa." (rect 1928 1504 2296 1532)(font "Arial" (font_size 8)))
(text "WRITE ACCESS CONTROL\nPamti prihvaceni WRITE zahtev, ceka zavrsetak tRCD\ni zatim aktivira WRITE komandu." (rect 1672 1608 1972 1650)(font "Arial" (font_size 8)))
(text "REQUEST_WRITE\nPamti da je prihvaceni pristup WRITE.\nBrise se po zavrsetku pristupa." (rect 2392 1664 2600 1706)(font "Arial" (font_size 8)))
(text "STATE_WRITE\nIzdaje WRITE komandu SDRAM-u." (rect 2448 1808 2637 1836)(font "Arial" (font_size 8)))
(text "STATE_WRITE_WAIT\nCekanje nakon WRITE komande pre PRECHARGE-a." (rect 1880 1824 2171 1852)(font "Arial" (font_size 8)))
(text "READ ACCESS CONTROL\nPamti prihvaceni READ zahtev, ceka tRCD,\nizdaje READ komandu, ceka CAS latenciju\ni zatim prihvata podatak sa DQ magistrale." (rect 2472 1264 2712 1320)(font "Arial" (font_size 8)))
(text "REQUEST_READ\nPamti da je prihvaceni pristup READ.\nBrise se po zavrsetku pristupa." (rect 3008 1264 3213 1306)(font "Arial" (font_size 8)))
(text "STATE_READ\nIzdaje READ komandu SDRAM-u." (rect 3528 1352 3714 1380)(font "Arial" (font_size 8)))
(text "READ wait 3\nCAS latency cekanje - treci takt" (rect 3080 1496 3258 1524)(font "Arial" (font_size 8)))
(text "READ wait 1\nCAS latency cekanje - prvi takt" (rect 2576 1424 2750 1452)(font "Arial" (font_size 8)))
(text "READ DATA REGISTER\nPrihvata validan podatak sa DQ[15..0]\nnakon CAS latency cekanja." (rect 3544 1488 3756 1530)(font "Arial" (font_size 8)))
(text "Procitani podatak dostupan ostatku sistema" (rect 3544 1440 3789 1454)(font "Arial" (font_size 8)))
(text "ACCESS PRECHARGE\nNakon zavrsenog READ ili WRITE pristupa\npokrece PRECHARGE izabranog banka i ceka tRP." (rect 2680 1608 2963 1650)(font "Arial" (font_size 8)))
(text "Pokretanje PRECHARGE-a nakon READ/WRITE zavrsetka" (rect 3128 1616 3450 1630)(font "Arial" (font_size 8)))
(text "STATE_PRECHARGE\nIzdaje PRECHARGE komandu izabranom banku." (rect 2704 1832 2971 1860)(font "Arial" (font_size 8)))
(text "STATE_PRECHARGE_WAIT\nCekanje tRP nakon PRECHARGE komande." (rect 3208 1848 3447 1876)(font "Arial" (font_size 8)))
(text "ACCESS CONTROL\nPokrece novi READ/WRITE pristup samo ako nema pending refresh-a.\nACCESS_ACTIVE ostaje aktivan tokom celog pristupa i brise se\ntek nakon zavrsetka PRECHARGE/tRP faze." (rect 2696 904 3090 960)(font "Arial" (font_size 8)))
(text "Refresh ima prioritet nad novim pristupom" (rect 2696 1000 2930 1014)(font "Arial" (font_size 8)))
(text "START_ACCESS\nPrihvata novi zahtev samo kada refresh nije potreban." (rect 3136 944 3442 972)(font "Arial" (font_size 8)))
(text "ACCESS_ACTIVE\nPamti da je normalni READ/WRITE pristup trenutno u toku.\nPostavlja se na START_ACCESS, brise se po zavrsetku pristupa." (rect 3168 1120 3538 1162)(font "Arial" (font_size 8)))
(text "nicemu jos ne sluzi" (rect 584 976 691 990)(font "Arial" (font_size 8)))
(text "SDRAM COMMAND GENERATION\nBira odgovarajucu SDRAM komandu u zavisnosti od aktivnog stanja.\nPodrazumevana komanda je NOP, a zatim se redom biraju\nPALL, REFRESH, MRS, ACTIVE, READ, WRITE i PRECHARGE." (rect 56 1928 443 1984)(font "Arial" (font_size 8)))
(text "PRECHARGE ALL komanda" (rect 56 2136 210 2150)(font "Arial" (font_size 8)))
(text "AUTO REFRESH komanda" (rect 280 2256 426 2270)(font "Arial" (font_size 8)))
(text "LOAD MODE REGISTER komanda" (rect 528 2256 715 2270)(font "Arial" (font_size 8)))
(text "ACTIVE komanda - otvara izabrani red/banku" (rect 760 2256 1014 2270)(font "Arial" (font_size 8)))
(text "READ komanda" (rect 1112 2256 1199 2270)(font "Arial" (font_size 8)))
(text "WRITE komanda" (rect 1368 2256 1458 2270)(font "Arial" (font_size 8)))
(text "PRECHARGE izabranog banka" (rect 1600 2256 1771 2270)(font "Arial" (font_size 8)))
(text "Command mux chain\nAktivno stanje bira komandu koja se salje SDRAM-u." (rect 1952 1936 2247 1964)(font "Arial" (font_size 8)))
(text "COMMAND REGISTER\nRegistruje izabranu komandu pre slanja na\nCS_N, RAS_N, CAS_N i WE_N izlaze." (rect 2160 2176 2400 2218)(font "Arial" (font_size 8)))
(text "SDRAM clock stalno omogucen" (rect 3264 1984 3441 1998)(font "Arial" (font_size 8)))
(text "RAS_N - Row Address Strobe\nCAS_N - Column Address Strobe\nWE_N  - Write Enable" (rect 3536 2088 3724 2130)(font "Arial" (font_size 8)))
(text "BANK ADDRESS SELECTION\nBira BA[1..0] u zavisnosti od trenutne SDRAM operacije.\nTokom MRS bira 00, a tokom ACTIVE/READ/WRITE/PRECHARGE\nkoristi bank iz ACCESS_ADDR[24..23]." (rect 3344 2232 3703 2288)(font "Arial" (font_size 8)))
(text "DEFAULT ADDRESS\nA12=0, A11=0, A10=CMD[3], A9..A0=0.\nOmogucava PRECHARGE ALL preko A10=1." (rect 1960 2336 2212 2378)(font "Arial" (font_size 8)))
(text "SDRAM ADDRESS SELECTION\nBira vrednost A[12..0] u zavisnosti od trenutne operacije:\ndefault/PRECHARGE, MRS, ACTIVE ili READ/WRITE." (rect 3384 2408 3708 2450)(font "Arial" (font_size 8)))
(text "DQ WRITE DRIVER\nTokom WRITE operacije vodi ACCESS_DATA_IN[15..0]\nna bidirekcionu DQ magistralu. U svim ostalim stanjima\nizlaz je u High-Z stanju kako bi SDRAM mogao da vozi DQ tokom READ-a." (rect 3368 2544 3782 2600)(font "Arial" (font_size 8)))
(text "WRITE: kontroler -> SDRAM\nREAD:  SDRAM -> kontroler" (rect 3544 2512 3699 2540)(font "Arial" (font_size 8)))
(text "DQM je aktivan na LOW" (rect 3184 2712 3317 2726)(font "Arial" (font_size 8)))
(text "DQM_ENABLE\nAktivan tokom READ sekvence i WRITE stanja." (rect 2776 2624 3037 2652)(font "Arial" (font_size 8)))
(text "ACCESS_DONE\nJednotaktni signal da je READ/WRITE pristup zavrsen.\nAktivira se nakon PRECHARGE/tRP faze." (rect 3216 2840 3520 2882)(font "Arial" (font_size 8)))
(text "DQM CONTROL / ACCESS COMPLETION\nOmogucava oba bajta tokom READ i WRITE pristupa.\nVan aktivnog pristupa DQML i DQMH su HIGH i maskiraju podatke." (rect 3544 2672 3914 2714)(font "Arial" (font_size 8)))
