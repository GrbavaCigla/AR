(header "graphic" (version "1.4"))
(symbol
	(rect 160 384 216 440)
	(text "ConstantX" (rect 5 0 72 15)(font "Arial" ))
	(text "inst" (rect 8 40 31 55)(font "Arial" ))
	(port
		(pt 56 32)
		(output)
		(text "DATA_OUT[size-1..0]" (rect -96 0 38 15)(font "Arial" ))
		(text "c" (rect 25 27 32 42)(font "Arial" )(invisible))
		(line (pt 56 32)(pt 40 32)(line_width 3))
	)
	(parameter
		"size"
		"16"
		""
		(type "PARAMETER_SIGNED_DEC")	)
	(parameter
		"const"
		"0"
		""
		(type "PARAMETER_SIGNED_DEC")	)
	(drawing
		(rectangle (rect 24 24 40 40)(fill (color 218 218 218)))
	)
	(annotation_block (parameter)(rect 216 336 432 384))
)
(connector
	(text "nula[15..0]" (rect 224 400 291 415)(font "Arial" ))
	(pt 216 416)
	(pt 304 416)
	(bus)
)
