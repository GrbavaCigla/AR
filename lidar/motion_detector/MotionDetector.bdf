(text "Prethodne detektovane tacke kako bismo utvrdili pomeraj!" (rect 264 312 655 328)(font "Arial" (font_size 8)))
(text "Za svaku tacku trazimo difference = |current_distance - previous_distance|" (rect 1264 328 1766 344)(font "Arial" (font_size 8)))
(text "current = pointk_dist" (rect 1432 352 1572 368)(font "Arial" (font_size 8)))
(text "prev = prevk" (rect 1432 368 1513 384)(font "Arial" (font_size 8)))
(text "pg => point greater" (rect 1456 392 1585 408)(font "Arial" (font_size 8)))
(text "pl => point less" (rect 1632 384 1738 400)(font "Arial" (font_size 8)))
